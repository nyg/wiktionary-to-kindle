<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.HeaderBar?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!--
    fx:controller declares the type; App installs a controllerFactory that constructs it with the log
    appender. The declaration is required even with a factory — FXMLLoader only consults the factory
    once it knows which controller class to ask for.
-->
<BorderPane fx:id="root" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="edu.self.w2k.gui.MainController">

    <fx:define>
        <ToggleGroup fx:id="pageGroup"/>
    </fx:define>

    <top>
        <VBox>
            <MenuBar fx:id="menuBar"/>

            <HeaderBar fx:id="headerBar" styleClass="header-bar">
                <left>
                    <Label fx:id="windowTitle" styleClass="window-title" HeaderBar.dragType="DRAGGABLE_SUBTREE"/>
                </left>
                <center>
                    <HBox fx:id="pageSwitcher" styleClass="segmented" HeaderBar.dragType="DRAGGABLE">
                        <ToggleButton fx:id="buildPageButton" text="Build" toggleGroup="$pageGroup"
                                      selected="true" styleClass="left-pill"/>
                        <ToggleButton fx:id="dumpsPageButton" text="Dumps" toggleGroup="$pageGroup"
                                      styleClass="right-pill"/>
                    </HBox>
                </center>
                <right>
                    <MenuButton fx:id="primaryMenuButton" styleClass="primary-menu">
                        <graphic>
                            <Region styleClass="primary-menu-icon"/>
                        </graphic>
                    </MenuButton>
                </right>
            </HeaderBar>
        </VBox>
    </top>

    <center>
        <StackPane>

            <BorderPane fx:id="buildPage" styleClass="page">
                <center>
                    <VBox styleClass="page-content">
                        <VBox fx:id="form" styleClass="form">
                            <HBox styleClass="form-row">
                                <Label text="Wiktionary edition" styleClass="form-label" HBox.hgrow="ALWAYS"/>
                                <ComboBox fx:id="editionCombo" styleClass="form-field"/>
                            </HBox>
                            <HBox styleClass="form-row">
                                <Label text="Word language" styleClass="form-label" HBox.hgrow="ALWAYS"/>
                                <ComboBox fx:id="wordLanguageCombo" styleClass="form-field"/>
                            </HBox>
                            <HBox styleClass="form-row, last">
                                <Label text="Dictionary title" styleClass="form-label" HBox.hgrow="ALWAYS"/>
                                <Label fx:id="titlePreview" styleClass="form-field, title-preview"/>
                            </HBox>
                        </VBox>

                        <ToggleButton fx:id="logToggle" text="Log" styleClass="disclosure">
                            <graphic>
                                <Region styleClass="disclosure-arrow"/>
                            </graphic>
                        </ToggleButton>
                        <ListView fx:id="logView" styleClass="log-view" VBox.vgrow="ALWAYS"/>
                    </VBox>
                </center>
                <bottom>
                    <HBox styleClass="footer">
                        <Button fx:id="revealButton" onAction="#onReveal"/>
                        <VBox fx:id="progressBox" styleClass="progress-box" HBox.hgrow="ALWAYS">
                            <Label fx:id="statusLabel" styleClass="status-label"/>
                            <ProgressBar fx:id="progressBar" progress="0" maxWidth="Infinity"/>
                        </VBox>
                        <Button fx:id="cancelButton" text="Cancel" onAction="#onCancel"/>
                        <Button fx:id="startButton" defaultButton="true" onAction="#onStart"/>
                    </HBox>
                </bottom>
            </BorderPane>

            <BorderPane fx:id="dumpsPage" styleClass="page">
                <center>
                    <VBox styleClass="page-content">
                        <TableView fx:id="dumpsTable" prefHeight="120" VBox.vgrow="ALWAYS">
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
                            </columnResizePolicy>
                            <columns>
                                <TableColumn fx:id="dumpLangColumn" text="Edition" prefWidth="180"/>
                                <TableColumn fx:id="dumpDateColumn" text="Generated" prefWidth="140"/>
                                <TableColumn fx:id="dumpSizeColumn" text="Size" prefWidth="100"/>
                            </columns>
                        </TableView>
                    </VBox>
                </center>
                <bottom>
                    <HBox styleClass="footer">
                        <Label fx:id="dumpsLocationLabel" styleClass="path-label"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="Refresh" onAction="#onRefreshDumps"/>
                        <Button fx:id="deleteDumpButton" text="Delete" onAction="#onDeleteDump"/>
                    </HBox>
                </bottom>
            </BorderPane>

        </StackPane>
    </center>

</BorderPane>
